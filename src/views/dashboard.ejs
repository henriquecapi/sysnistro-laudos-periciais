<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - LaudoIA</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 h-screen flex overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-slate-800 text-white p-4 flex flex-col">
        <h1 class="text-xl font-bold mb-8">LaudoIA Pro</h1>
        <nav class="space-y-2 flex-1">
            <a href="/dashboard" class="block p-2 bg-slate-700 rounded transition">📊 Dashboard</a>
            <a href="/editor" class="block p-2 hover:bg-slate-700 rounded transition">📄 Novo Laudo</a>
            <a href="/knowledge" class="block p-2 hover:bg-slate-700 rounded transition">📚 Conhecimento</a>
        </nav>
        <div class="mt-auto border-t border-slate-700 pt-4">
            <p class="text-sm text-slate-400 mb-2">User: <%= user %>
            </p>
            <a href="/logout" class="block p-2 hover:bg-red-700 rounded text-center transition">Sair</a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 overflow-y-auto">
        <header class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-bold text-slate-800">Dashboard</h2>
            <a href="/editor" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">+ Criar Novo
                Laudo</a>
        </header>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded shadow">
                <h3 class="text-gray-500 text-sm font-bold uppercase">Laudos Criados</h3>
                <p class="text-3xl font-bold text-slate-800">0</p>
            </div>
            <div class="bg-white p-6 rounded shadow">
                <h3 class="text-gray-500 text-sm font-bold uppercase">Documentos na Base</h3>
                <p class="text-3xl font-bold text-slate-800">0</p>
            </div>
            <div class="bg-white p-6 rounded shadow">
                <h3 class="text-gray-500 text-sm font-bold uppercase">Versão do Sistema</h3>
                <p class="text-3xl font-bold text-slate-800">v1.0.0</p>
            </div>
        </div>

        <!-- Recent Reports List (Mockup) -->
        <div class="bg-white rounded shadow overflow-hidden">
            <div class="px-6 py-4 border-b">
                <h3 class="font-bold text-slate-800">Laudos Recentes</h3>
            </div>
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 text-gray-600 text-sm">
                        <th class="p-4 border-b">ID</th>
                        <th class="p-4 border-b">Título</th>
                        <th class="p-4 border-b">Data</th>
                        <th class="p-4 border-b">Status</th>
                        <th class="p-4 border-b">Ações</th>
                    </tr>
                </thead>
                <tbody class="text-gray-700">
                    <tr>
                        <td class="p-4 border-b" colspan="5" class="text-center text-gray-500">Nenhum laudo encontrado.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>
</body>

</html>